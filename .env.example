# Backend
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-jwt-token

# Frontend origin allowed for CORS (e.g. https://gym-tracker.vercel.app)
ALLOWED_ORIGIN=https://your-deployment.vercel.app

# Optional
NODE_ENV=production
API_MAX_BODY_MB=2
SYNC_RATE_LIMIT_PER_MIN=60
AUTH_RATE_LIMIT_PER_MIN=10